generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String            @map("display_name")
  role             String            @default("user")
  email            String            @unique
  emailVerified    Boolean           @default(false) @map("email_verified")
  image            String?
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @default(now()) @map("updated_at") @db.Timestamptz(6)
  accounts         Account[]
  sessions         Session[]
  careerGoals      CareerGoal[]
  practiceSessions PracticeSession[]
  skillAssessments SkillAssessment[]
  consents         UserConsent[]
  identities       AuthIdentity[]
  agentConversations AgentConversation[]
  interviewExperienceReports InterviewExperienceReport[]
  companyCapturesSubmitted CompanySourceCapture[] @relation("CompanyCaptureSubmitter")
  companyCapturesReviewed CompanySourceCapture[] @relation("CompanyCaptureReviewer")
  evidenceClaimsCreated CompanyEvidenceClaim[] @relation("EvidenceClaimCreator")
  evidenceClaimsReviewed CompanyEvidenceClaim[] @relation("EvidenceClaimReviewer")
  jobApplications JobApplication[]
  jobTimelineEvents JobTimelineEvent[]
  recommendationActions CareerRecommendationAction[]
  apiRateLimitCounters ApiRateLimitCounter[]
  questionBankItems QuestionBankItem[]
  questionCollections QuestionCollection[]

  @@map("users")
}

model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([identifier])
  @@map("verifications")
}

model AuthIdentity {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  provider        String
  providerSubject String   @map("provider_subject")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@unique([userId, provider])
  @@map("auth_identities")
}

model CareerGoal {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String            @map("user_id") @db.Uuid
  targetRole       String            @map("target_role")
  targetCompany    String?           @map("target_company")
  targetDate       DateTime?         @map("target_date") @db.Date
  status           String            @default("active")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @default(now()) @map("updated_at") @db.Timestamptz(6)
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  practiceSessions PracticeSession[]
  skillAssessments SkillAssessment[]
  roadmapTasks     CareerRoadmapTask[]
  jobApplications JobApplication[]
  recommendationActions CareerRecommendationAction[]

  @@index([userId, status])
  @@map("career_goals")
}

model PracticeSession {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String            @map("user_id") @db.Uuid
  goalId      String?           @map("goal_id") @db.Uuid
  roadmapTaskId String?          @map("roadmap_task_id") @db.Uuid
  module      String
  title       String
  status      String            @default("in_progress")
  startedAt   DateTime          @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt DateTime?         @map("completed_at") @db.Timestamptz(6)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal        CareerGoal?       @relation(fields: [goalId], references: [id], onDelete: SetNull)
  roadmapTask CareerRoadmapTask? @relation(fields: [roadmapTaskId], references: [id], onDelete: SetNull)
  attempts    PracticeAttempt[]

  @@index([userId, startedAt(sort: Desc)])
  @@index([goalId])
  @@index([roadmapTaskId, startedAt(sort: Desc)])
  @@map("practice_sessions")
}

model PracticeAttempt {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId    String         @map("session_id") @db.Uuid
  prompt       String
  responseText String?        @map("response_text")
  feedbackJson Json?          @map("feedback_json") @db.JsonB
  score        Decimal?       @db.Decimal(5, 2)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  session      PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("practice_attempts")
}

model SkillAssessment {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  goalId       String?   @map("goal_id") @db.Uuid
  skillKey     String    @map("skill_key")
  rating       Int
  evidenceNote String?   @map("evidence_note")
  assessedAt   DateTime  @default(now()) @map("assessed_at") @db.Timestamptz(6)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal         CareerGoal? @relation(fields: [goalId], references: [id], onDelete: SetNull)

  @@index([userId, skillKey, assessedAt(sort: Desc)])
  @@map("skill_assessments")
}

model UserConsent {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  purpose       String
  policyVersion String    @map("policy_version")
  grantedAt     DateTime  @default(now()) @map("granted_at") @db.Timestamptz(6)
  withdrawnAt  DateTime? @map("withdrawn_at") @db.Timestamptz(6)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, purpose, policyVersion])
  @@index([userId, purpose])
  @@map("user_consents")
}


model CareerRoadmapTask {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  goalId      String     @map("goal_id") @db.Uuid
  taskKey     String     @map("task_key")
  title       String
  description String
  skillKey    String     @map("skill_key")
  module      String
  phase       String
  sortOrder   Int        @map("sort_order")
  status      String     @default("todo")
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)
  evidenceClaimId String? @map("evidence_claim_id") @db.Uuid
  goal        CareerGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  evidenceClaim CompanyEvidenceClaim? @relation(fields: [evidenceClaimId], references: [id], onDelete: SetNull)
  recommendationActions CareerRecommendationAction[]
  practiceSessions PracticeSession[]

  @@unique([goalId, taskKey])
  @@index([goalId, sortOrder])
  @@map("career_roadmap_tasks")
}

model AgentConversation {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  skillSlug String         @map("skill_slug")
  title     String         @default("New conversation")
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime       @default(now()) @map("updated_at") @db.Timestamptz(6)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AgentMessage[]

  @@index([userId, updatedAt(sort: Desc)])
  @@map("agent_conversations")
}

model AgentMessage {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String           @map("conversation_id") @db.Uuid
  role           String
  content        String
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  conversation   AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("agent_messages")
}


model InterviewExperienceReport {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  company        String
  role           String
  experienceLevel String  @map("experience_level")
  roundType      String   @map("round_type")
  difficulty     String
  interviewDate  DateTime? @map("interview_date") @db.Date
  questionText   String   @map("question_text")
  experienceNote String?  @map("experience_note")
  sourceUrl      String?  @map("source_url")
  contentHash    String   @map("content_hash")
  reviewNote     String?  @map("review_note")
  reviewedByUserId String? @map("reviewed_by_user_id") @db.Uuid
  status         String   @default("pending")
  reviewedAt     DateTime? @map("reviewed_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, company, role])
  @@index([contentHash, status])
  @@index([userId, createdAt(sort: Desc)])
  @@map("interview_experience_reports")
}


model CompanySourceCapture {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceId       String    @map("source_id")
  company        String
  sourceTitle    String    @map("source_title")
  sourceUrl      String    @map("source_url")
  retrievedAt    DateTime  @map("retrieved_at") @db.Timestamptz(6)
  httpStatus     Int       @map("http_status")
  contentHash    String    @map("content_hash")
  pageTitle      String    @map("page_title")
  description    String
  excerpt        String
  status         String    @default("pending")
  submittedById  String    @map("submitted_by_id") @db.Uuid
  reviewedById   String?   @map("reviewed_by_id") @db.Uuid
  reviewNote     String?   @map("review_note")
  reviewedAt     DateTime? @map("reviewed_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  submitter      User      @relation("CompanyCaptureSubmitter", fields: [submittedById], references: [id], onDelete: Cascade)
  reviewer       User?     @relation("CompanyCaptureReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  claims         CompanyEvidenceClaim[]

  @@unique([sourceId, contentHash])
  @@index([status, createdAt])
  @@index([company, sourceId, retrievedAt(sort: Desc)])
  @@map("company_source_captures")
}


model CompanyEvidenceClaim {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  captureId         String   @map("capture_id") @db.Uuid
  company           String
  role              String
  claimType         String   @map("claim_type")
  claimText         String   @map("claim_text")
  supportingExcerpt String   @map("supporting_excerpt")
  status            String   @default("pending")
  createdById       String   @map("created_by_id") @db.Uuid
  reviewedById      String?  @map("reviewed_by_id") @db.Uuid
  reviewNote        String?  @map("review_note")
  reviewedAt        DateTime? @map("reviewed_at") @db.Timestamptz(6)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  capture           CompanySourceCapture @relation(fields: [captureId], references: [id], onDelete: Cascade)
  roadmapTasks      CareerRoadmapTask[]
  creator           User     @relation("EvidenceClaimCreator", fields: [createdById], references: [id], onDelete: Cascade)
  reviewer          User?    @relation("EvidenceClaimReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, company, role])
  @@index([captureId])
  @@map("company_evidence_claims")
}


model JobApplication {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  goalId          String?   @map("goal_id") @db.Uuid
  company         String
  role            String
  location        String?
  sourceUrl       String?   @map("source_url")
  jobDescription  String    @map("job_description")
  status          String    @default("saved")
  appliedAt       DateTime? @map("applied_at") @db.Date
  notes           String?
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal            CareerGoal? @relation(fields: [goalId], references: [id], onDelete: SetNull)
  preparationTasks JobPreparationTask[]
  timelineEvents JobTimelineEvent[]
  recommendationActions CareerRecommendationAction[]

  @@index([userId, status, updatedAt(sort: Desc)])
  @@index([goalId])
  @@map("job_applications")
}


model JobPreparationTask {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId       String   @map("job_id") @db.Uuid
  skillKey    String   @map("skill_key")
  title       String
  description String
  module      String
  status      String   @default("todo")
  sortOrder   Int      @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  job         JobApplication @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, skillKey])
  @@index([jobId, status, sortOrder])
  @@map("job_preparation_tasks")
}


model JobTimelineEvent {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId       String   @map("job_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  eventType   String   @map("event_type")
  title       String
  details     String?
  scheduledAt DateTime @map("scheduled_at") @db.Timestamptz(6)
  status      String   @default("pending")
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  job         JobApplication @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, scheduledAt])
  @@index([jobId, scheduledAt])
  @@map("job_timeline_events")
}


model CareerRecommendationAction {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  goalId         String?       @map("goal_id") @db.Uuid
  jobId          String?       @map("job_id") @db.Uuid
  roadmapTaskId  String?       @map("roadmap_task_id") @db.Uuid
  sourceKey      String        @map("source_key")
  title          String
  reason         String
  href           String
  basis          String
  status         String        @default("accepted")
  dueAt          DateTime?     @map("due_at") @db.Timestamptz(6)
  acceptedAt     DateTime?     @map("accepted_at") @db.Timestamptz(6)
  completedAt    DateTime?     @map("completed_at") @db.Timestamptz(6)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal           CareerGoal?   @relation(fields: [goalId], references: [id], onDelete: SetNull)
  job            JobApplication? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  roadmapTask    CareerRoadmapTask? @relation(fields: [roadmapTaskId], references: [id], onDelete: SetNull)

  @@unique([userId, sourceKey])
  @@index([userId, status, dueAt])
  @@index([goalId])
  @@index([jobId])
  @@map("career_recommendation_actions")
}


model ApiRateLimitCounter {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  bucket          String
  windowStartedAt DateTime @map("window_started_at") @db.Timestamptz(6)
  requestCount    Int      @default(0) @map("request_count")
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, bucket])
  @@index([updatedAt])
  @@map("api_rate_limit_counters")
}


model QuestionBankItem {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  role           String
  category       String
  difficulty     String
  title          String
  prompt         String
  followUp       String   @map("follow_up")
  topics         String[] @default([])
  evaluation     String[] @default([])
  hint           String
  companyContext String   @default("General practice") @map("company_context")
  fingerprint    String
  source         String   @default("ai")
  isSaved        Boolean  @default(false) @map("is_saved")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  collections    QuestionCollectionItem[]

  @@unique([userId, fingerprint])
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, category, difficulty])
  @@map("question_bank_items")
}

model QuestionCollection {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  name        String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       QuestionCollectionItem[]

  @@unique([userId, name])
  @@index([userId, createdAt(sort: Desc)])
  @@map("question_collections")
}

model QuestionCollectionItem {
  collectionId String   @map("collection_id") @db.Uuid
  questionId   String   @map("question_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  collection   QuestionCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  question     QuestionBankItem @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([collectionId, questionId])
  @@index([questionId])
  @@map("question_collection_items")
}
