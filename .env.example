# Copy this file to .env.local for local development.
# Never commit real credentials.

# Database (provider to be selected before enabling persistence)
DATABASE_URL=

# Authentication (provider to be selected)
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# AI provider (server-side only; never expose keys with NEXT_PUBLIC_)
AI_API_KEY=
AI_MODEL=

# Optional public app URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
