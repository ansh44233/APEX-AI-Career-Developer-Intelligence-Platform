generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String            @map("display_name")
  email            String            @unique
  emailVerified    Boolean           @default(false) @map("email_verified")
  image            String?
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @default(now()) @map("updated_at") @db.Timestamptz(6)
  accounts         Account[]
  sessions         Session[]
  careerGoals      CareerGoal[]
  practiceSessions PracticeSession[]
  skillAssessments SkillAssessment[]
  consents         UserConsent[]
  identities       AuthIdentity[]
  agentConversations AgentConversation[]

  @@map("users")
}

model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([identifier])
  @@map("verifications")
}

model AuthIdentity {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  provider        String
  providerSubject String   @map("provider_subject")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@unique([userId, provider])
  @@map("auth_identities")
}

model CareerGoal {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String            @map("user_id") @db.Uuid
  targetRole       String            @map("target_role")
  targetCompany    String?           @map("target_company")
  targetDate       DateTime?         @map("target_date") @db.Date
  status           String            @default("active")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @default(now()) @map("updated_at") @db.Timestamptz(6)
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  practiceSessions PracticeSession[]
  skillAssessments SkillAssessment[]
  roadmapTasks     CareerRoadmapTask[]

  @@index([userId, status])
  @@map("career_goals")
}

model PracticeSession {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String            @map("user_id") @db.Uuid
  goalId      String?           @map("goal_id") @db.Uuid
  module      String
  title       String
  status      String            @default("in_progress")
  startedAt   DateTime          @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt DateTime?         @map("completed_at") @db.Timestamptz(6)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal        CareerGoal?       @relation(fields: [goalId], references: [id], onDelete: SetNull)
  attempts    PracticeAttempt[]

  @@index([userId, startedAt(sort: Desc)])
  @@index([goalId])
  @@map("practice_sessions")
}

model PracticeAttempt {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId    String         @map("session_id") @db.Uuid
  prompt       String
  responseText String?        @map("response_text")
  feedbackJson Json?          @map("feedback_json") @db.JsonB
  score        Decimal?       @db.Decimal(5, 2)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  session      PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("practice_attempts")
}

model SkillAssessment {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  goalId       String?   @map("goal_id") @db.Uuid
  skillKey     String    @map("skill_key")
  rating       Int
  evidenceNote String?   @map("evidence_note")
  assessedAt   DateTime  @default(now()) @map("assessed_at") @db.Timestamptz(6)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal         CareerGoal? @relation(fields: [goalId], references: [id], onDelete: SetNull)

  @@index([userId, skillKey, assessedAt(sort: Desc)])
  @@map("skill_assessments")
}

model UserConsent {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  purpose       String
  policyVersion String    @map("policy_version")
  grantedAt     DateTime  @default(now()) @map("granted_at") @db.Timestamptz(6)
  withdrawnAt  DateTime? @map("withdrawn_at") @db.Timestamptz(6)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, purpose, policyVersion])
  @@index([userId, purpose])
  @@map("user_consents")
}


model CareerRoadmapTask {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  goalId      String     @map("goal_id") @db.Uuid
  taskKey     String     @map("task_key")
  title       String
  description String
  skillKey    String     @map("skill_key")
  module      String
  phase       String
  sortOrder   Int        @map("sort_order")
  status      String     @default("todo")
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)
  goal        CareerGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@unique([goalId, taskKey])
  @@index([goalId, sortOrder])
  @@map("career_roadmap_tasks")
}

model AgentConversation {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  skillSlug String         @map("skill_slug")
  title     String         @default("New conversation")
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime       @default(now()) @map("updated_at") @db.Timestamptz(6)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AgentMessage[]

  @@index([userId, updatedAt(sort: Desc)])
  @@map("agent_conversations")
}

model AgentMessage {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String           @map("conversation_id") @db.Uuid
  role           String
  content        String
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  conversation   AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("agent_messages")
}
